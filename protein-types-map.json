    },
    {
      "id": "enzymes",
      "type": "note",
      "title": "Enzymes",
      "content": "Speed up chemical reactions. Example: amylase, which breaks down starch.",
      "x": 0,
      "y": 420,
      "createdAt": 1793189123069
    },
    {
      "id": "structural",
      "type": "note",
      "title": "Structural",
      "content": "Give cells and tissues strength. Examples: collagen, keratin.",
      "x": 240,
      "y": 420,
      "createdAt": 1793189123069
    },
    {
      "id": "transport",
      "type": "note",
      "title": "Transport",
      "content": "Carry molecules around the body. Example: haemoglobin carries oxygen.",
      "x": 480,
      "y": 420,
      "createdAt": 1793189123069
    },
    {
      "id": "hormones",
      "type": "note",
      "title": "Hormones",
      "content": "Send signals between cells. Example: insulin.",
      "x": 0,
      "y": 600,
      "createdAt": 1793189123069
    },
    {
      "id": "antibodies",
      "type": "note",
      "title": "Antibodies",
      "content": "Recognise and fight germs as part of the immune system.",
      "x": 240,
      "y": 600,
      "createdAt": 1793189123069
    },
    {
      "id": "motor",
      "type": "note",
      "title": "Motor",
      "content": "Make things move. Examples: actin and myosin in muscle.",
      "x": 480,
      "y": 600,
      "createdAt": 1793189123069
    },
    {
      "id": "fibrous",
      "type": "note",
      "title": "Fibrous",
      "content": "Long and rope-like, tough and insoluble. Example: collagen.",
      "x": 820,
      "y": 420,
      "createdAt": 1793189123069
    },
    {
      "id": "globular",
      "type": "note",
      "title": "Globular",
      "content": "Compact and round, usually water-soluble. Examples: enzymes, haemoglobin.",
      "x": 1060,
      "y": 420,
      "createdAt": 1793189123069
    },
    {
      "id": "membrane",
      "type": "note",
      "title": "Membrane",
      "content": "Sit in cell membranes as channels, pumps and receptors.",
      "x": 1300,
      "y": 420,
      "createdAt": 1793189123069
    }
  ],
