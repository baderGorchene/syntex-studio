{
  "name": "synthex-studio",
  "productName": "Synthex Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/graph.test.mjs tests/sync.test.mjs",
    "collab": "npm --prefix collab-server install --no-audit --no-fund && npm --prefix collab-server start",
    "desktop": "node scripts/desktop-prepare.mjs && electron .",
    "desktop:build": "node scripts/desktop-prepare.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.82",
    "@clerk/nextjs": "^7.9.7",
    "@google-cloud/storage": "^8.2.0",
    "@hocuspocus/provider": "^4.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "ai": "^7.0.123",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sqlite-vec": "^0.1.9",
    "stripe": "^22.6.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.synthex.studio",
    "productName": "Synthex Studio",
    "files": [
      "electron/**",
      "!node_modules/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/.env*",
          "!public/uploads/**"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*",
          "!**/*.db",
          "!**/*.db-*",
          "!**/.env*",
          "!public/uploads/**"
        ]
      }
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "protocols": [
      {
        "name": "Synthex",
        "schemes": [
          "synthex"
        ]
      }
    ],
    "win": {
      "icon": "src/app/icon.png"
    }
  }
}
